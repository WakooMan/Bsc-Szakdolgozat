<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SupportedOSPlatformVersion Condition="'$(SupportedOSPlatformVersion)' == ''">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="'$(TargetPlatformMinVersion)' == ''">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Data\seven_wonders_easy_agent.onnx" />
    <None Remove="Data\seven_wonders_easy_agent.onnx.data" />
    <None Remove="Data\seven_wonders_hard_agent.onnx" />
    <None Remove="Data\seven_wonders_hard_agent.onnx.data" />
    <None Remove="Data\seven_wonders_medium_agent.onnx" />
    <None Remove="Data\seven_wonders_medium_agent.onnx.data" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\AllWeights.xml">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Data\seven_wonders_easy_agent.onnx">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Data\seven_wonders_easy_agent.onnx.data">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Data\seven_wonders_hard_agent.onnx" />
    <EmbeddedResource Include="Data\seven_wonders_hard_agent.onnx.data" />
    <EmbeddedResource Include="Data\seven_wonders_medium_agent.onnx" />
    <EmbeddedResource Include="Data\seven_wonders_medium_agent.onnx.data" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SevenWonders.Game.Logic\SevenWonders.Game.Logic.csproj" />
    <ProjectReference Include="..\SevenWonders.Common\SevenWonders.Common.csproj" />
  </ItemGroup>

</Project>
