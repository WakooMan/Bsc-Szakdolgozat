<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SevenWonders.UI.Views.PlayerNamePage"
             Title="PlayerNamePage">
    <Grid Background="WhiteSmoke" HorizontalOptions="Fill" VerticalOptions="Fill">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
        </Grid.RowDefinitions>
        <Label Text="{Binding Player1NameText}" FontSize="Medium" HorizontalOptions="Center" Grid.Row="0" Margin="10"/>
        <Entry Text="{Binding Player1Name, Mode=TwoWay}" Grid.Row="1" FontSize="Medium" Margin="10" Background="Black" HorizontalOptions="Fill" HorizontalTextAlignment="Center" TextColor="White" MaxLength="8"/>
        <Label Text="{Binding Player2NameText}" FontSize="Medium" HorizontalOptions="Center" Grid.Row="2" Margin="10"/>
        <Entry Text="{Binding Player2Name, Mode=TwoWay}" Grid.Row="3" FontSize="Medium" Margin="10" Background="Black" HorizontalOptions="Fill" HorizontalTextAlignment="Center" TextColor="White" MaxLength="8"/>
        <Button Text="{Binding StartText}" FontSize="Medium" BackgroundColor="Black" Command="{Binding StartCommand}" Grid.Row="4" Margin="10" />
        <Button Text="{Binding BackText}" FontSize="Medium" BackgroundColor="Black" Command="{Binding BackCommand}" Grid.Row="5" Margin="10" />
    </Grid>
</ContentPage>