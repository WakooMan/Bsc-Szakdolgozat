<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SevenWonders.UI.Views.RegisterPage"
             Title="RegisterPage">
    <Grid Background="WhiteSmoke" HorizontalOptions="Fill" VerticalOptions="Fill">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <Label Text="{Binding UserNameLabelText}" FontSize="Large" HorizontalOptions="Center" Grid.Row="0" TextColor="Black" Margin="10"/>
        <Entry Text="{Binding UserName, Mode=TwoWay}" Grid.Row="1" FontSize="Medium" Margin="10" Background="Black" HorizontalOptions="Fill" HorizontalTextAlignment="Center" TextColor="White" MaxLength="20"/>
        <Label Text="{Binding UserNameError}" FontSize="Small" TextColor="Red" HorizontalOptions="Center" Grid.Row="2"/>

        <Label Text="{Binding EmailLabelText}" FontSize="Large" HorizontalOptions="Center" Grid.Row="3" TextColor="Black" Margin="10"/>
        <Entry Text="{Binding Email, Mode=TwoWay}" Grid.Row="4" FontSize="Medium" Margin="10" Background="Black" HorizontalOptions="Fill" HorizontalTextAlignment="Center" TextColor="White" Keyboard="Email"/>
        <Label Text="{Binding EmailError}" FontSize="Small" TextColor="Red" HorizontalOptions="Center" Grid.Row="5"/>

        <Label Text="{Binding PasswordLabelText}" FontSize="Large" HorizontalOptions="Center" Grid.Row="6" TextColor="Black" Margin="10"/>
        <Entry Text="{Binding Password, Mode=TwoWay}" Grid.Row="7" IsPassword="True" FontSize="Medium" Margin="10" Background="Black" HorizontalOptions="Fill" HorizontalTextAlignment="Center" TextColor="White" MaxLength="20"/>
        <Label Text="{Binding PasswordError}" FontSize="Small" TextColor="Red" HorizontalOptions="Center" Grid.Row="8"/>

        <Button Text="{Binding RegisterText}" FontSize="Medium" BackgroundColor="Black" Command="{Binding RegisterCommand}" Grid.Row="9" Margin="10" TextColor="White"/>
        <Button Text="{Binding NavigateToLoginText}" FontSize="Small" BackgroundColor="Black" Command="{Binding NavigateToLoginCommand}" Grid.Row="10" Margin="10" TextColor="White"/>
    </Grid>
</ContentPage>