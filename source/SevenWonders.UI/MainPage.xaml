<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             xmlns:local="clr-namespace:SevenWonders.UI.ViewModels"
             x:Class="SevenWonders.UI.MainPage">
    <Grid Background="WhiteSmoke" HorizontalOptions="Fill" VerticalOptions="Fill">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
        </Grid.RowDefinitions>
        <Label Text="{Binding Title}" FontSize="Large" HorizontalOptions="Center" Grid.Row="0"/>
        <Button Text="{Binding SingleplayerText}" FontSize="Medium" BackgroundColor="Black" Command="{Binding SinglePlayerCommand}" Grid.Row="1" Margin="10" />
        <Button Text="{Binding MultiplayerText}" FontSize="Medium" BackgroundColor="Black" Command="{Binding MultiplayerCommand}" Grid.Row="2" Margin="10"/>
        <Button Text="{Binding ExitText}" FontSize="Medium" BackgroundColor="Black" Command="{Binding ExitCommand}" Grid.Row="3" Margin="10"/>
    </Grid>
</ContentPage>
