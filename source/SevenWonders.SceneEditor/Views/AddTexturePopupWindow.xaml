<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="SevenWonders.SceneEditor.Views.AddTexturePopupWindow"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">
    <Border Stroke="Black"
     StrokeThickness="4"
     Background="White"
     HorizontalOptions="Center"
     VerticalOptions="Center">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="40,40,40,40" />
        </Border.StrokeShape>
        <VerticalStackLayout HorizontalOptions="Center" 
                             VerticalOptions="Center" 
                             Margin="10">  
            <Label Text="Texture name:"/>
            <Entry MaxLength="10" 
                   Text="{Binding Name, Mode=TwoWay}" 
                   TextColor="White" 
                   Background="Gray" 
                   HorizontalTextAlignment="Center"/>
            <Label Text="Texture id:"/>
            <Entry MaxLength="10" 
                   Keyboard="Numeric" 
                   Text="{Binding Id, Mode=TwoWay}" 
                   TextColor="White" 
                   Background="Gray" 
                   HorizontalTextAlignment="Center"/>
            <Label Text="Texture type id:"/>
            <Entry MaxLength="10" 
                   Keyboard="Numeric" 
                   Text="{Binding TextureId, Mode=TwoWay}" 
                   TextColor="White" 
                   Background="Gray" 
                   HorizontalTextAlignment="Center"/>
            <Label Text="Width:"/>
            <Entry MaxLength="10" 
                   Keyboard="Numeric" 
                   Text="{Binding Width, Mode=TwoWay}" 
                   TextColor="White" 
                   Background="Gray" 
                   HorizontalTextAlignment="Center"/>

            <Label Text="Height:"/>
            <Entry MaxLength="10" 
                   Keyboard="Numeric" 
                   Text="{Binding Height, Mode=TwoWay}" 
                   TextColor="White" 
                   Background="Gray" 
                   HorizontalTextAlignment="Center"/>
            <HorizontalStackLayout HorizontalOptions="Center">
                <Label Text="Is Visible: "
                       HorizontalOptions="Center"/>
                <CheckBox IsChecked="{Binding Visible}" />
            </HorizontalStackLayout>
            <HorizontalStackLayout HorizontalOptions="Center">
                <Button Text="Choose file"
                        Clicked="FilePicker_Clicked" />
                <Label Text="{Binding SelectedFileName}" 
                       HorizontalOptions="Center" />
            </HorizontalStackLayout>
            <HorizontalStackLayout HorizontalOptions="Center">
                <Button Text="Add" 
                        Grid.Column="0" 
                        Margin="5" 
                        Background="Gray" 
                        Command="{Binding OnAddCommand}" 
                        Clicked="FilePicker_Clicked"/>
                <Button Text="Back" 
                        Grid.Column="1" 
                        Margin="5" 
                        Background="Gray" 
                        Command="{Binding OnBackCommand}" 
                        Clicked="FilePicker_Clicked"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>