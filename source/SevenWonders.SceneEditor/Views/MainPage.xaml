<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SevenWonders.SceneEditor.Views.MainPage"
             xmlns:local="clr-namespace:SevenWonders.SceneEditor.ViewModels"
             x:DataType="local:MainPageViewModel"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">
    <ScrollView>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="8*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Background="Gray">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="9*" />
                </Grid.RowDefinitions>
                <StackLayout Grid.Row="0" IsVisible="{Binding IsLeftPanelVisible}">
                    <StackLayout Orientation="Horizontal">
                        <Label>Name:</Label>
                        <Label Text="{Binding Name, Mode=TwoWay}"/>
                    </StackLayout>
                    <StackLayout Orientation="Horizontal">
                        <Label>Id:</Label>
                        <Label Text="{Binding Id, Mode=TwoWay}"/>
                    </StackLayout>
                    <StackLayout Orientation="Horizontal">
                        <Label Text="IsVisible:"/>
                        <Label Text="{Binding IsVisible, Mode=TwoWay}"/>
                    </StackLayout>
                </StackLayout>
                <VerticalStackLayout Grid.Row="1" IsVisible="{Binding IsLeftPanelVisible}">
                    <HorizontalStackLayout HorizontalOptions="Center">
                        <Button Text="Layers"
                    Clicked="OnLayersClicked" />
                        <Button Text="Textures"
                    Clicked="OnTexturesClicked" />
                        <Button Text="GameObjects"
                    Clicked="OnGameObjectsClicked" />
                    </HorizontalStackLayout>

                    <Grid x:Name="TabContentArea">
                        <VerticalStackLayout x:Name="LayersContent">
                            <ListView ItemsSource="{Binding LayerViews}" ItemSelected="Layer_ItemSelected">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:LayerListViewModel">
                                        <TextCell Text="{Binding Name}" Detail="{Binding Id}"/>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button Text="Add Layer" Background="Black" Clicked="Add_New_Layer_Clicked"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="TexturesContent" IsVisible="False">
                            <ListView ItemsSource="{Binding TextureViews}" ItemSelected="Texture_ItemSelected">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:TextureListViewModel">
                                        <TextCell Text="{Binding Name}" Detail="{Binding Id}"/>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button Text="Add Texture" Background="Black" Clicked="Add_New_Texture_Clicked"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout x:Name="GameObjectsContent" IsVisible="False">
                            <ListView ItemsSource="{Binding GameObjectViews}" ItemSelected="GameObject_ItemSelected">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:GameObjectListViewModel">
                                        <TextCell Text="{Binding Name}" Detail="{Binding Id}"/>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button Text="Add GameObject" Background="Black" Clicked="Add_New_GameObject_Clicked"/>
                        </VerticalStackLayout>

                    </Grid>
                </VerticalStackLayout>
            </Grid>
            <Grid Grid.Column="1" Background="Black">
                <Grid HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding ButtonsAreVisible, Mode=TwoWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" />
                        <ColumnDefinition Width="5*" />
                    </Grid.ColumnDefinitions>
                    <Button Text="Choose Scene" Grid.Column="0" Margin="5" Background="Gray"/>
                    <Button Text="Add New Scene" Grid.Column="1" Margin="5" Background="Gray" Clicked="Add_New_Scene_Clicked"/>
                </Grid>
                <skia:SKCanvasView x:Name="canvas"
                   PaintSurface="OnCanvasViewPaintSurface"
                   HorizontalOptions="Fill"
                   VerticalOptions="Fill"
                   IsVisible="{Binding CanvasIsVisible, Mode=TwoWay}"/>
            </Grid>
        </Grid>
    </ScrollView>

</ContentPage>
