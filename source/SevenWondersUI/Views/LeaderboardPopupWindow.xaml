<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="SevenWondersUI.Views.LeaderboardPopupWindow"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    CanBeDismissedByTappingOutsideOfPopup="False">
    <Border Stroke="Black"
            StrokeThickness="4"
            Background="White"
            HorizontalOptions="Center"
            VerticalOptions="Center">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="40,40,40,40" />
        </Border.StrokeShape>
        <Grid HorizontalOptions="Fill"
              VerticalOptions="Center"
              Margin="20"
              WidthRequest="350">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label Grid.Row="0"
                   Text="{Binding Title}"
                   FontAttributes="Bold"
                   FontSize="20"
                   TextColor="Black"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,16" />

            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding Entries}"
                            HeightRequest="300">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="5,2" ColumnDefinitions="Auto, *, Auto">
                            <Label Grid.Column="0"
                                   Text="{Binding UserName}"
                                   FontSize="14"
                                   TextColor="Black"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="2"
                                   Text="{Binding Wins, StringFormat='{0} gy?zelem'}"
                                   FontSize="14"
                                   TextColor="Black"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Grid.Row="2"
                    Text="{Binding CloseButtonText}"
                    Background="Black"
                    TextColor="White"
                    HorizontalOptions="Center"
                    Margin="0,16,0,0"
                    Clicked="CloseButton_Clicked" />
        </Grid>
    </Border>
</toolkit:Popup>
