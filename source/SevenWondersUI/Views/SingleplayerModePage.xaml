<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SevenWondersUI.Views.SingleplayerModePage"
             Title="SingleplayerModePage">
    <Grid Background="WhiteSmoke" HorizontalOptions="Fill" VerticalOptions="Fill">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
        </Grid.RowDefinitions>
        <Label Text="{Binding Title}" FontSize="Large" HorizontalOptions="Center" Grid.Row="0"/>
        <Button Text="{Binding PlayerVsPlayerText}" FontSize="Medium" BackgroundColor="Black" Command="{Binding PlayerVsPlayerCommand}" Grid.Row="1" Margin="10" />
        <Button Text="{Binding PlayerVsAIText}" FontSize="Medium" BackgroundColor="Black" Command="{Binding PlayerVsAICommand}" Grid.Row="2" Margin="10"/>
        <Button Text="{Binding BackText}" FontSize="Medium" BackgroundColor="Black" Command="{Binding BackCommand}" Grid.Row="3" Margin="10"/>
    </Grid>
</ContentPage>